<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.omarlahmimi.glutt</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The Ray-Ban Meta camera stream runs over Wi-Fi, not Bluetooth. Without
	     these the stream sits in waitingForDevice and dies deviceNotConnected.
	     Both are in Meta's own CameraAccess sample, and both need a paid team:
	     a personal team cannot provision them at all. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
