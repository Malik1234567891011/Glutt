<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.omarlahmimi.glutt</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Nothing about networking or accessories belongs here.

	     `com.apple.developer.networking.wifi-info` used to sit in this file. It
	     existed only so a probe could report which network the phone was on
	     while a pair of Ray-Ban Meta glasses was streaming, and it went out with
	     the rest of that work on this branch. It has no other caller.

	     Adding an entitlement Glutt does not exercise is how 1.2.2 (16) was
	     rejected under guideline 2.5.4: the review found a Bluetooth background
	     mode with no Bluetooth functionality behind it. Anything added here
	     needs a feature a reviewer can actually reach. -->
</dict>
</plist>
