<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  True since the Facebook SDK landed, for the Meta ad campaigns. Glutt sends
	  app launches and one `StartTrial` conversion to Meta, and Meta links that
	  to its own data to attribute the install. That is tracking under Apple's
	  definition, whatever the events themselves look like.

	  Which is why `TrackingPermission` exists: ATT must be *asked* if this says
	  true, and iOS blocks every request to the domain below until it is granted.
	  The Facebook SDK ships the same domain in its own manifest, so listing it
	  here changes nothing at runtime — it makes Glutt's own manifest honest.
	-->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>ep1.facebook.com</string>
	</array>
	<!--
	  This list stopped being empty in 1.2.1. Accounts and recipe sync mean the
	  library no longer lives only on the phone: signed in, recipes and their
	  cover images are stored in Supabase against the account, and the account
	  carries the name and email from Sign in with Apple or Google.

	  Not listed, deliberately: microphone audio during a cook. It is streamed to
	  the model to answer with and never stored by us. Recipe text and photos sent
	  to the AI provider for a single import are the same case — what is listed
	  below is what is *retained* against an account.

	  The App Store Connect privacy questionnaire has to say the same things this
	  file does. Changing one without the other is how an app gets rejected.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Sign in with Apple / Google, stored on the profile row. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<!-- Also rides along as a PostHog person property. -->
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The recipe library itself: titles, ingredients, steps, notes. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Recipe cover images, synced so a new phone gets the library back. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- PostHog: the Supabase user id (or an install id before sign-in). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		  Screens viewed, imports run, cooks started. Two consumers with very
		  different terms, and the label has to describe the wider of them:
		  PostHog gets the detail and does not track, the Facebook SDK gets app
		  launches and the trial start and does. Hence tracking = true here.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
		<!--
		  The IDFA, and the IDFV the Facebook SDK falls back to when ATT is not
		  granted. Not linked: it never reaches the Supabase profile or PostHog,
		  it exists only so Meta can attribute an install to a campaign.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
		  The `StartTrial` conversion carries the product id, its price and the
		  currency. No card details and no App Store receipt: Apple keeps those,
		  and nothing in Glutt ever sees them.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: app's own settings (AI key/model, seed version). -->
				<string>CA92.1</string>
				<!-- 1C8F.1: app-group defaults shared with the share extension. -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
