<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.omarlahmimi.glutt</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The Ray-Ban Meta camera stream runs over Wi-Fi, not Bluetooth. Without
	     these the stream sits in waitingForDevice and dies deviceNotConnected.
	     Both are in Meta's own CameraAccess sample, and both need a paid team:
	     a personal team cannot provision them at all. -->
	<!-- SPIKE: HotspotConfiguration removed so the toolkit cannot stand up the
	     softAP even if it wants to. The ExternalAccessory keys in Info.plist are
	     what should select Bluetooth; this is the belt to that pair of braces.

	     `wifi-info` deliberately KEPT. It is read-only, cannot cause a join, and
	     is the only way NetworkProbe can report which network the phone is
	     actually on — which is the entire result we are here to measure.
	     Removing it to eliminate an implausible confounder would cost the
	     instrumentation that makes the run worth doing.

	     Restore HotspotConfiguration before anything ships. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
