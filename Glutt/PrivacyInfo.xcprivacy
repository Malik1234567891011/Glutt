<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Glutt does not track users across apps/sites owned by other companies. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  No data is collected by the developer: everything lives on-device in
	  SwiftData. (Recipe/photo content sent to the AI provider for processing
	  is disclosed in the App Store Connect privacy questionnaire, not here —
	  this file covers data the developer collects and required-reason APIs.)
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: app's own settings (AI key/model, seed version). -->
				<string>CA92.1</string>
				<!-- 1C8F.1: app-group defaults shared with the share extension. -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
